# From Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Pick your own admin password
ADMIN_PASSWORD=choose-a-strong-password

# Random string used to sign the admin login cookie. Generate one at
# https://1password.com/password-generator/ (32+ characters, letters+numbers is fine)
ADMIN_TOKEN=replace-with-a-long-random-string
